# When the KaiOS phone is plugged in, start the user's kaios-sync service.
# 1782 = Unisoc/Spreadtrum USB vendor ID; install.sh replaces it with what `lsusb` shows for your phone.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1782", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="kaios-sync.service"
